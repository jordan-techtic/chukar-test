# Database configuration
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/marketing_cal"
TEST_DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/marketing_cal_test"

# Application
ENVIRONMENT="development"

# JWT configuration (local HS256 — not an external OAuth2/OIDC provider)
AUTH_STRATEGY="jwt"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Rate limiting
RATE_LIMIT_DEFAULT="100/minute"

# Klaviyo (password recovery emails and optional campaign performance)
KLAVIYO_API_KEY=""
KLAVIYO_MAX_RETRIES=3
KLAVIYO_PERFORMANCE_ENABLED=false
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
FRONTEND_RESET_URL="http://localhost:3000/reset-password"

# Application branding
ORGANIZATION_NAME="Marketing Content Calendar"
